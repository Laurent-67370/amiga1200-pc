--- a/libretro/libretro.cpp
+++ b/libretro/libretro.cpp
@@ -2322,6 +2322,14 @@ static const char* get_option_value(const char* key)
 	return nullptr;
 }
 
+/* amiga1200 : jeu WHDLoad dans une archive autre que .lha (dossier du jeu zippé, .7z, .lzx), signalé par le frontal ;
+   le lanceur WHDLoad d'Amiberry sait déjà y chercher le .slave et la monter */
+static bool libretro_whdload_archive(const std::string& ext)
+{
+	const char* v = get_option_value("amiberry_whdload_archive");
+	return v && !strcmp(v, "enabled") && (ext == "zip" || ext == "7z" || ext == "lzx");
+}
+
 static void libretro_reset_crop_policy();
 
